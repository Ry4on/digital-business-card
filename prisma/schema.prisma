generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String             @id
  name        String
  description String
  links       ProfessionalLink[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model ProfessionalLink {
  id        String  @id
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label     String
  url       String
  sortOrder Int

  @@unique([profileId, label])
  @@index([profileId, sortOrder])
}

model Skill {
  id        String  @id
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int

  @@unique([profileId, name])
  @@index([profileId, sortOrder])
}

model Experience {
  id           String    @id
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String
  position     String
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  achievements String[]
  sortOrder    Int

  @@index([profileId, sortOrder])
}

model Project {
  id          String  @id
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  description String
  url         String
  sortOrder   Int

  @@unique([profileId, name])
  @@index([profileId, sortOrder])
}
