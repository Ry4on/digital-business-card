{
  "name": "evgeny-digital-business-card",
  "version": "1.0.0",
  "private": true,
  "description": "A read-only GraphQL business card built with NestJS, Prisma and PostgreSQL",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "start": "pnpm db:deploy && pnpm db:seed && node dist/src/main.js",
    "start:dev": "pnpm build && pnpm start",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node dist/prisma/seed.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/unit/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test .test-dist/test/integration/*.test.js"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "14.0.3",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "graphql": "^16.11.0",
    "pg": "^8.16.3",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "typescript": "~5.9.3"
  }
}
